// MembershipProver handles the proving process for membership verification
type MembershipProver struct {
	setup *setup.MembershipSetup
}

// NewMembershipProver creates a new membership prover with the given setup
func NewMembershipProver(setup *setup.MembershipSetup) *MembershipProver {
	return &MembershipProver{
		setup: setup,
	}
}

// ProveMembership generates a zero-knowledge proof for membership verification
func (p *MembershipProver) ProveMembership(proofData *types.MembershipProofData) (*groth16.Proof, error) {
	startTime := time.Now()

	// Convert proof data to circuit assignment
	assignment, err := p.convertToMembershipCircuitAssignment(proofData)
	if err != nil {
		return nil, fmt.Errorf("failed to convert membership proof data: %w", err)
	}

	// Create witness
	witness, err := circuit.NewMembershipWitness(
		circuit.NewMembershipCircuit(
			p.setup.HashToPrimeBits,
			p.setup.FieldSizeBits,
			p.setup.IntegerCommitmentG,
			p.setup.IntegerCommitmentH,
			p.setup.PedersenCommitmentG,
			p.setup.PedersenCommitmentH,
			p.setup.AccumulatorG,
		),
		assignment,
	)
	if err != nil {
		return nil, fmt.Errorf("failed to create membership witness: %w", err)
	}

	// Generate proof
	proof, err := groth16.Prove(p.setup.ProvingKey, witness)
	if err != nil {
		return nil, fmt.Errorf("failed to generate membership proof: %w", err)
	}

	proofTime := time.Since(startTime)
	fmt.Printf("Membership proof generation took: %v\n", proofTime)

	return proof, nil
}

// convertToMembershipCircuitAssignment converts membership proof data to circuit assignment
func (p *MembershipProver) convertToMembershipCircuitAssignment(proofData *types.MembershipProofData) (*circuit.MembershipCircuitAssignment, error) {
	// Parse big integers from strings
	accumulatorValue, ok := new(big.Int).SetString(proofData.AccumulatorValue, 10)
	if !ok {
		return nil, fmt.Errorf("invalid accumulator value: %s", proofData.AccumulatorValue)
	}

	integerCommitment, ok := new(big.Int).SetString(proofData.IntegerCommitment, 10)
	if !ok {
		return nil, fmt.Errorf("invalid integer commitment: %s", proofData.IntegerCommitment)
	}

	rootAlpha1, ok := new(big.Int).SetString(proofData.RootProof.Alpha1, 10)
	if !ok {
		return nil, fmt.Errorf("invalid root alpha1: %s", proofData.RootProof.Alpha1)
	}

	// Parse elliptic curve points
	pedersenCommitment, err := parseEllipticPoint(proofData.PedersenCommitment)
	if err != nil {
		return nil, fmt.Errorf("invalid pedersen commitment: %w", err)
	}

	modeqAlpha1, err := parseEllipticPoint(proofData.ModEqProof.Alpha1)
	if err != nil {
		return nil, fmt.Errorf("invalid modeq alpha1: %w", err)
	}

	modeqAlpha2, err := parseEllipticPoint(proofData.ModEqProof.Alpha2)
	if err != nil {
		return nil, fmt.Errorf("invalid modeq alpha2: %w", err)
	}

	// Parse witness values
	element, ok := new(big.Int).SetString(proofData.WitnessData.Element, 10)
	if !ok {
		return nil, fmt.Errorf("invalid element: %s", proofData.WitnessData.Element)
	}

	randomness, ok := new(big.Int).SetString(proofData.WitnessData.Randomness, 10)
	if !ok {
		return nil, fmt.Errorf("invalid randomness: %s", proofData.WitnessData.Randomness)
	}

	randomnessQ, ok := new(big.Int).SetString(proofData.WitnessData.RandomnessQ, 10)
	if !ok {
		return nil, fmt.Errorf("invalid randomness_q: %s", proofData.WitnessData.RandomnessQ)
	}

	// Parse root proof values
	rootSE, ok := new(big.Int).SetString(proofData.RootProof.SE, 10)
	if !ok {
		return nil, fmt.Errorf("invalid root s_e: %s", proofData.RootProof.SE)
	}

	rootSR, ok := new(big.Int).SetString(proofData.RootProof.SR, 10)
	if !ok {
		return nil, fmt.Errorf("invalid root s_r: %s", proofData.RootProof.SR)
	}

	rootChallenge, ok := new(big.Int).SetString(proofData.RootProof.Challenge, 10)
	if !ok {
		return nil, fmt.Errorf("invalid root challenge: %s", proofData.RootProof.Challenge)
	}

	// Parse ModEq proof values
	modeqSE, ok := new(big.Int).SetString(proofData.ModEqProof.SE, 10)
	if !ok {
		return nil, fmt.Errorf("invalid modeq s_e: %s", proofData.ModEqProof.SE)
	}

	modeqSR, ok := new(big.Int).SetString(proofData.ModEqProof.SR, 10)
	if !ok {
		return nil, fmt.Errorf("invalid modeq s_r: %s", proofData.ModEqProof.SR)
	}

	modeqSRQ, ok := new(big.Int).SetString(proofData.ModEqProof.SRq, 10)
	if !ok {
		return nil, fmt.Errorf("invalid modeq s_r_q: %s", proofData.ModEqProof.SRq)
	}

	modeqChallenge, ok := new(big.Int).SetString(proofData.ModEqProof.Challenge, 10)
	if !ok {
		return nil, fmt.Errorf("invalid modeq challenge: %s", proofData.ModEqProof.Challenge)
	}

	// Parse hash-to-prime values
	hashToPrimeChallenge, ok := new(big.Int).SetString(proofData.HashToPrimeProof.Challenge, 10)
	if !ok {
		return nil, fmt.Errorf("invalid hash_to_prime challenge: %s", proofData.HashToPrimeProof.Challenge)
	}

	originalElement, ok := new(big.Int).SetString(proofData.HashToPrimeProof.OriginalElement, 10)
	if !ok {
		return nil, fmt.Errorf("invalid original element: %s", proofData.HashToPrimeProof.OriginalElement)
	}

	hashedPrime, ok := new(big.Int).SetString(proofData.HashToPrimeProof.HashedPrime, 10)
	if !ok {
		return nil, fmt.Errorf("invalid hashed prime: %s", proofData.HashToPrimeProof.HashedPrime)
	}

	// Create bit decomposition for range proof
	bitDecomposition := make([]frontend.Variable, proofData.HashToPrimeProof.RangeBits)
	for i, bit := range proofData.HashToPrimeProof.BitDecomposition {
		bitDecomposition[i] = frontend.Variable(bit)
	}

	// Create membership circuit assignment
	assignment := &circuit.MembershipCircuitAssignment{
		// Public inputs
		AccumulatorValue:  accumulatorValue,
		IntegerCommitment:  integerCommitment,
		PedersenCommitment: *pedersenCommitment,

		// Proof components
		RootAlpha1:          rootAlpha1,
		ModEqAlpha1:         *modeqAlpha1,
		ModEqAlpha2:         *modeqAlpha2,

		HashToPrimeChallenge: hashToPrimeChallenge,
		OriginalElement:     originalElement,
		HashedPrime:         hashedPrime,

		// Private witness
		Element:      element,
		Randomness:   randomness,
		RandomnessQ:  randomnessQ,

		// Root witness
		RootSE:      rootSE,
		RootSR:      rootSR,
		RootChallenge: rootChallenge,

		// ModEq witness
		ModEqSE:      modeqSE,
		ModEqSR:      modeqSR,
		ModEqSRQ:     modeqSRQ,
		ModEqChallenge: modeqChallenge,

		// Range proof witness
		BitDecomposition: bitDecomposition,
	}

	return assignment, nil
}

// ProveMembershipFromBridgeData generates proof from bridge API response
func (p *MembershipProver) ProveMembershipFromBridgeData(bridgeData *types.MembershipBridgeResponse) (*groth16.Proof, error) {
	if bridgeData.Status != "success" {
		return nil, fmt.Errorf("bridge operation failed: %s", bridgeData.Error)
	}

	if bridgeData.ProofData == nil {
		return nil, fmt.Errorf("no proof data in bridge response")
	}

	return p.ProveMembership(bridgeData.ProofData)
}

// BenchmarkMembershipProofGeneration benchmarks membership proof generation performance
func (p *MembershipProver) BenchmarkMembershipProofGeneration(
	testCases []types.MembershipTestCaseData,
	iterations int,
) (*types.MembershipProofBenchmarkResult, error) {
	if len(testCases) == 0 {
		return nil, fmt.Errorf("no test cases provided")
	}

	successCount := 0
	totalTime := time.Duration(0)
	minTime := time.Duration(1<<63 - 1) // Max time.Duration
	maxTime := time.Duration(0)
	proofSizes := make([]int, 0, iterations)

	for i := 0; i < iterations; i++ {
		testCase := testCases[i%len(testCases)]
		start := time.Now()

		proof, err := p.ProveMembership(testCase.ProofData)
		duration := time.Since(start)

		if err != nil {
			fmt.Printf("Membership proof generation failed for iteration %d: %v\n", i, err)
			continue
		}

		successCount++
		totalTime += duration

		if duration < minTime {
			minTime = duration
		}
		if duration > maxTime {
			maxTime = duration
		}

		// Get proof size (this would depend on actual proof structure)
		proofSize := estimateMembershipProofSize(proof)
		proofSizes = append(proofSizes, proofSize)

		fmt.Printf("Membership iteration %d: %v, proof size: %d bytes\n", i, duration, proofSize)
	}

	if successCount == 0 {
		return nil, fmt.Errorf("all membership proof generation attempts failed")
	}

	averageTime := totalTime / time.Duration(successCount)

	// Calculate statistics
	avgProofSize := 0
	for _, size := range proofSizes {
		avgProofSize += size
	}
	avgProofSize /= len(proofSizes)

	return &types.MembershipProofBenchmarkResult{
		Iterations:         iterations,
		SuccessfulProofs:   successCount,
		SuccessRate:        float64(successCount) / float64(iterations),
		AverageTimeMs:      float64(averageTime.Nanoseconds()) / 1_000_000.0,
		MinTimeMs:          float64(minTime.Nanoseconds()) / 1_000_000.0,
		MaxTimeMs:          float64(maxTime.Nanoseconds()) / 1_000_000.0,
		TotalTimeMs:        float64(totalTime.Nanoseconds()) / 1_000_000.0,
		AverageProofSize:   avgProofSize,
	}, nil
}

// estimateMembershipProofSize estimates size of a membership proof in bytes
func estimateMembershipProofSize(proof *groth16.Proof) int {
	if proof == nil {
		return 0
	}

	// This is a rough estimate - actual size depends on curve and proof format
	// Groth16 proofs on BN254 are approximately 288 bytes
	// Membership proofs might be slightly larger due to additional components
	return 288
}

// CreateMembershipTestProofData creates test membership proof data for benchmarking
func CreateMembershipTestProofData(numCases int) []types.MembershipTestCaseData {
	testCases := make([]types.MembershipTestCaseData, numCases)

	// Use same test elements as Rust membership benchmark
	// From membership_hash.rs: LARGE_PRIMES = [12702637924034044211, 378373571372703133, 8640171141336142787]
	testElements := []string{
		"12702637924034044211",
		"378373571372703133",
		"8640171141336142787",
	}

	testRandomness := []string{
		"5",
		"9",
		"13",
	}

	for i := 0; i < numCases; i++ {
		element, _ := new(big.Int).SetString(testElements[i%len(testElements)], 10)
		randomness, _ := new(big.Int).SetString(testRandomness[i%len(testRandomness)], 10)

		// Create mock membership proof data for testing
		// In a real implementation, this would come from the Rust bridge API
		testCases[i] = types.MembershipTestCaseData{
			Element:    element,
			Randomness: randomness,
			ProofData: &types.MembershipProofData{
				AccumulatorValue: "123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890",
				IntegerCommitment:  "987654321098765432109876543210987654321098765432109876543210987654321098765432109876543210987654321",

				// Root proof data
				RootProof: types.RootProofData{
					Alpha1:    "23456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789",
					SE:        "34567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890",
					SR:        "45678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901",
					Challenge: "56789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012",
				},

				// ModEq proof data
				ModEqProof: types.ModEqProofData{
					Alpha1: &types.EllipticPoint{
						X: "123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890",
						Y: "234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901",
					},
					Alpha2: &types.EllipticPoint{
						X: "345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012",
						Y: "456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123",
					},
					SE:        "56789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789",
					SR:        "67890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890",
					SRq:       "78901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901",
					Challenge: "89012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012",
				},

				// Hash-to-prime proof data
				HashToPrimeProof: types.HashToPrimeProofData{
					Challenge:       "90123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123",
					OriginalElement: "01234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234",
					HashedPrime:     "12345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345",
					RangeBits:       254,
					BitDecomposition: make([]int, 254), // Mock bit decomposition
				},

				// Pedersen commitment
				PedersenCommitment: &types.EllipticPoint{
					X: "234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901",
					Y: "345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012",
				},

				// Witness data
				WitnessData: types.MembershipWitnessData{
					Element:      element.String(),
					Randomness:   randomness.String(),
					RandomnessQ:  "78901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901",
				},
			},
		}
	}

	return testCases
}